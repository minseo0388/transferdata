PORT=3333
SESSION_SECRET=a_very_secure_session_secret_key
UPLOAD_DIR=uploads

# ==========================================
# Discord OAuth Configuration
# ==========================================
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
# URL must match EXACTLY what is registered in the Discord Developer Portal
DISCORD_CALLBACK_URL=http://localhost:3333/auth/discord/callback

# ==========================================
# Google OAuth Configuration
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# URL must match EXACTLY what is registered in the Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3333/auth/google/callback

# ==========================================
# Admin Setup
# ==========================================
# Specifying these gives the user access to the /admin page to approve new users.
# You can set either or both depending on which login method you use.
ADMIN_DISCORD_ID=your_discord_user_id
ADMIN_GOOGLE_EMAIL=your_google_email@gmail.com
