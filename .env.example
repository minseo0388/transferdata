PORT=3000
# 디스코드 애플리케이션 정보를 입력하세요
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# 디스코드 개발자 포털의 Redirect URI에도 반드시 아래 주소를 똑같이 등록하세요. 
# 배포시에는 배포 도메인으로 변경해야 합니다!
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
SESSION_SECRET=a_very_secure_secret_key

# 파일 업로드 권한을 줄 특정 디스코드 서버(길드)와 역할(Role) ID를 기재해주세요.
# (비워두면 디스코드 로그인만으로 누구나 업로드 가능하게 됨)
REQUIRED_GUILD_ID=your_guild_id_here
REQUIRED_ROLE_ID=your_role_id_here

UPLOAD_DIR=uploads
