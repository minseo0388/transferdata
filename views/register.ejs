<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>회원가입 승인 신청 - Secure Data Transfer</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>

    <div class="container" style="max-width: 500px;">
        <h1>가입 신청</h1>
        <p class="subtitle">서비스를 이용하시려면 관리자의 승인이 필요합니다.</p>

        <form id="registerForm" action="/auth/register" method="POST" style="margin-top: 2rem; text-align: left;">
            <input type="hidden" name="provider" value="<%= provider %>">
            
            <div class="input-group">
                <label for="username">사용자 이름</label>
                <input type="text" id="username" name="username" value="<%= tempUser.name || tempUser.username || '' %>" required autocomplete="off">
            </div>

            <div class="input-group" style="margin-top: 1rem;">
                <label for="confirmIdentifier">
                    <%= provider === 'google' ? '구글 이메일 확인' : '디스코드 ID 확인' %>
                </label>
                <input type="text" id="confirmIdentifier" name="confirmIdentifier" placeholder="<%= provider === 'google' ? 'user@gmail.com' : '디스코드 숫자 ID' %>" required autocomplete="off">
                <small style="color: rgba(255,255,255,0.5); display: block; margin-top: 5px;">본인 확인을 위해 위 정보를 정확히 입력해주세요.</small>
            </div>

            <div id="statusMessage" style="margin-top: 1rem; text-align: center; color: #ff6b6b; display: none;"></div>

            <div class="actions" style="margin-top: 2rem;">
                <button type="submit" class="btn"><i class="fas fa-paper-plane"></i> 승인 신청하기</button>
            </div>
        </form>
    </div>

    <script>
        document.getElementById('registerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const form = this;
            const btn = form.querySelector('button[type="submit"]');
            const statusMessage = document.getElementById('statusMessage');
            
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 처리 중...';
            statusMessage.style.display = 'none';

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        provider: form.provider.value,
                        username: form.username.value,
                        confirmIdentifier: form.confirmIdentifier.value
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    alert(data.message);
                    window.location.href = data.redirect || '/';
                } else {
                    statusMessage.textContent = data.message;
                    statusMessage.style.display = 'block';
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-paper-plane"></i> 승인 신청하기';
                }
            } catch(err) {
                statusMessage.textContent = '서버 통신 중 오류가 발생했습니다.';
                statusMessage.style.display = 'block';
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane"></i> 승인 신청하기';
            }
        });
    </script>
</body>
</html>
